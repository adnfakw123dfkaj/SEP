{
  "include": ["scripts/gates", "eval"],
  "exclude": [
    "tradingagents",
    "tests",
    "**/__pycache__",
    "**/.pytest_cache"
  ],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.11",
  "reportMissingImports": "error",
  "reportUnusedImport": "error",
  "reportUnusedVariable": "error"
}
